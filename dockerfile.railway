FROM kartoza/geoserver:2.28.2

USER root

# Use /tmp for ephemeral Railway filesystem
ENV GEOSERVER_DATA_DIR=/tmp/geoserver_data
ENV GEOWEBCACHE_CACHE_DIR=/tmp/gwc
ENV FOOTPRINTS_DATA_DIR=/tmp/footprints

# Low memory for Railway free tier
ENV INITIAL_MEMORY=256M
ENV MAXIMUM_MEMORY=512M

# Railway proxy configuration (fixes CSP form-action errors)
# Railway exposes apps via HTTPS on port 443
ENV HTTP_PROXY_PORT=443
ENV HTTPS_PROXY_PORT=443

# Railway injects $PORT and $RAILWAY_PUBLIC_DOMAIN - configure both
COPY --chown=geoserver:geoserver <<'EOF' /scripts/railway-config.sh
#!/bin/bash
PORT=${PORT:-8080}
echo "Configuring Tomcat for Railway PORT=$PORT"
sed -i "s/port=\"8080\"/port=\"$PORT\"/g" /usr/local/tomcat/conf/server.xml

# Set proxy name if Railway domain is provided
if [ -n "$RAILWAY_PUBLIC_DOMAIN" ]; then
  echo "Setting proxy name: $RAILWAY_PUBLIC_DOMAIN"
  export HTTP_PROXY_NAME="$RAILWAY_PUBLIC_DOMAIN"
  export HTTPS_PROXY_NAME="$RAILWAY_PUBLIC_DOMAIN"
fi
EOF

RUN chmod +x /scripts/railway-config.sh

# Wrap entrypoint to inject Railway config first
ENTRYPOINT ["/bin/bash", "-c", "/scripts/railway-config.sh && exec /scripts/entrypoint.sh \"$@\"", "--"]